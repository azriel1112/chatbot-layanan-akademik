APP_ENV=development
PORT=5000

CLIENT_ORIGINS=http://localhost:5173,https://chatbot-layanan-akademik.vercel.app

FAQ_DATA_PATH=data/faqs.json
RUNTIME_ASSETS_PATH=data/runtime_assets.json
INTENT_MODEL_PATH=models/intent_classifier.json
EVALUATION_ARTIFACTS_DIR=reports/model-evaluation

# Development lokal menggunakan JSONL.
LOG_STORAGE=jsonl
CONVERSATION_LOG_PATH=logs/conversations.jsonl

# Production menggunakan database PostgreSQL.
# LOG_STORAGE=database
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

SESSION_TTL_SECONDS=1800
MAX_SESSIONS=1000